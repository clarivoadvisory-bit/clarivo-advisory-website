{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": true,
  "routes": [
    {
      "src": "/cortex-markets/(.*)",
      "dest": "/cortex-markets/$1"
    },
    {
      "src": "/cortex-markets/?$",
      "dest": "/cortex-markets/index.html"
    },
    {
      "src": "/pharmaceutical-nutraceutical/(.*)",
      "dest": "/pharmaceutical-nutraceutical/$1"
    },
    {
      "src": "/pharmaceutical-nutraceutical/?$",
      "dest": "/pharmaceutical-nutraceutical/index.html"
    },
    {
      "src": "/web-development/(.*)",
      "dest": "/web-development/$1"
    },
    {
      "src": "/web-development/?$",
      "dest": "/web-development/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
